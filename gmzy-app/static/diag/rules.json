 "vs": [
  {
   "a": "feng_han",
   "b": "biao_xu",
   "text": "同在太阳、皆恶风寒：风寒表证无汗脉浮紧，卫阳被遏；表虚证汗出脉浮缓，营卫不和。辨之在【汗】。",
   "refs": "《伤寒论讲解》太阳病篇"
  },
  {
   "a": "pi_qixu",
   "b": "pi_shi_kun",
   "text": "脾气虚以乏力少食便溏为主，苔多薄；脾虚湿困以脘闷身重、苔白腻为主，湿浊阻滞之象明显。",
   "refs": "《中医内科学》泄泻"
  },
  {
   "a": "shen_yinxu",
   "b": "yx_hw",
   "text": "肾阴虚以腰酸耳鸣、失于滋养为主；阴虚火旺则潮热盗汗、五心烦热等火象毕露，是阴虚的进一步发展。",
   "refs": "《中医内科学》虚劳"
  },
  {
   "a": "gan_yu",
   "b": "gan_huo",
   "text": "肝郁主情志抑郁、胁胀善太息而无热象；肝火则口苦目赤、急躁、舌红苔黄脉弦数，郁极化火。",
   "refs": "《中医内科学》郁证·胁痛"
  },
  {
   "a": "wei_fen",
   "b": "feng_re",
   "text": "卫分证与风热表证症候相近：温病卫分口微渴、咽红痛更明显，病情传变迅速；普通风热表证相对轻浅。治法均宗辛凉。",
   "refs": "《温病条辨讲解》上焦篇"
  },
  {
   "a": "ying_fen",
   "b": "xue_fen",
   "text": "营分证斑疹隐隐、心烦不寐、舌红绛少苔；血分证斑疹显露、各窍出血、神昏谵语，入血则危重。",
   "refs": "《温病条辨讲解》卫气营血辨证"
  },
  {
   "a": "pi_yangxu",
   "b": "shen_yangxu",
   "text": "脾阳虚以脘腹冷痛、食少便溏为主，病位在中焦；肾阳虚以腰膝酸冷、夜尿频多、五更泄为主，病位在下元。",
   "refs": "《中医内科学》虚劳"
  }
 ]
